;; Base layer: the 3 main thumb keys become mod/taps

(deflayer base
  _    _    _    _    _    _    _    _    _    _    _
  q    w    e    r    t         y    u    i    o    p
  a    s    d    f    g         h    j    k    l    ;
  z    x    c    v    b    <    n    m    ,    .    /
            @alt          @nav            @sym
)

;; TODO switch space and altgr layer?? or TODO alt gr also working as seq so can release to type awkwards chars.

;; TODO some easy to access numrow , maybe altgr then alt but what to hold?? should just
taphold a key that got no use repeating (both little finger ?? ala homerow: sounds good but maybe a bit slow for vim like use: should be under space? then a locked nav layer accessed under space something: sounds good).


;; Timing variables are defined in `kanata.kbd` file.

(defalias
  ;; Main mod-tap: Nav layer when held, Space when tapped.
  nav (tap-hold $tap_timeout $long_hold_timeout spc (layer-while-held navigation))

  ;; Space-cadet thumb keys: Alt/BackSpace, AltGr/Enter.
  ;; Acts as a modifier by default, or as BackSpace/Enter when tapped separately.
  sym (tap-hold-press $tap_timeout $hold_timeout ret (layer-while-held symbols))
  alt (tap-hold-press $tap_timeout $hold_timeout bspc lsft)
  ;; TODO tap-hold of alt + altgr with alt press first (otherwhise it is altgr layer: avoid
  ;; having a leftshift layer: actually maybe lshift + altgr) -> two layers.
  ;; A-altgr or S-altgr ???
)

